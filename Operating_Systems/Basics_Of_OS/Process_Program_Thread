## Practical Examples & Code

### 1. Creating Processes (Java)

import java.io.BufferedReader;
import java.io.InputStreamReader;

public class ProcessExample {
    
    public static void main(String[] args) throws Exception {
        System.out.println("Main Process ID: " + ProcessHandle.current().pid());
        
        // Create multiple processes
        Process[] processes = new Process[3];
        
        for (int i = 0; i < 3; i++) {
            // Launch a new Java process (can be any command)
            ProcessBuilder pb = new ProcessBuilder("java", "-version");
            processes[i] = pb.start();
            
            System.out.println("Process " + i + " (PID: " + processes[i].pid() + ") started");
        }
        
        // Wait for all processes to complete
        for (int i = 0; i < 3; i++) {
            int exitCode = processes[i].waitFor();
            System.out.println("Process " + i + " completed with exit code: " + exitCode);
        }
        
        System.out.println("All processes completed");
    }
}

### 2. Creating Threads (Java)

public class ThreadExample {
    
    static class Worker extends Thread {
        private String name;
        
        public Worker(String name) {
            this.name = name;
        }
        
        @Override
        public void run() {
            System.out.println("Thread " + name + " (ID: " + 
                             Thread.currentThread().getId() + ") started");
            
            for (int i = 0; i < 3; i++) {
                System.out.println(name + ": " + i);
                try {
                    Thread.sleep(500); // Sleep for 500ms
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
            }
            
            System.out.println("Thread " + name + " completed");
        }
    }
    
    public static void main(String[] args) {
        System.out.println("Main Thread ID: " + Thread.currentThread().getId());
        
        // Create multiple threads
        Thread[] threads = new Thread[3];
        for (int i = 0; i < 3; i++) {
            threads[i] = new Worker("T" + i);
            threads[i].start();
        }
        
        // Wait for all threads to complete
        for (int i = 0; i < 3; i++) {
            try {
                threads[i].join();
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
        
        System.out.println("All threads completed");
    }
}

### 3. Process vs. Thread Performance (Java)

public class ThreadPerformanceComparison {
    
    private static final int NUM_THREADS = 4;
    private static final long NUM_ITERATIONS = 1_000_000_000L;
    
    static class Worker extends Thread {
        public long count = 0;
        
        @Override
        public void run() {
            for (long i = 0; i < NUM_ITERATIONS; i++) {
                count++;
            }
        }
    }
    
    public static void main(String[] args) throws InterruptedException {
        System.out.println("Thread Performance Comparison");
        System.out.println("Threads: " + NUM_THREADS);
        System.out.println("Iterations per thread: " + NUM_ITERATIONS);
        System.out.println();
        
        // Measure thread execution time
        Worker[] threads = new Worker[NUM_THREADS];
        long startTime = System.nanoTime();
        
        // Create and start threads
        for (int i = 0; i < NUM_THREADS; i++) {
            threads[i] = new Worker();
            threads[i].start();
        }
        
        // Wait for all threads to complete
        for (int i = 0; i < NUM_THREADS; i++) {
            threads[i].join();
        }
        
        long endTime = System.nanoTime();
        double timeInSeconds = (endTime - startTime) / 1_000_000_000.0;
        
        System.out.println("Time taken (threads): " + String.format("%.4f", timeInSeconds) + " seconds");
        System.out.println();
        
        // Measure sequential execution time for comparison
        long startTime2 = System.nanoTime();
        long totalCount = 0;
        for (int i = 0; i < NUM_THREADS; i++) {
            for (long j = 0; j < NUM_ITERATIONS; j++) {
                totalCount++;
            }
        }
        long endTime2 = System.nanoTime();
        double timeInSeconds2 = (endTime2 - startTime2) / 1_000_000_000.0;
        
        System.out.println("Time taken (sequential): " + String.format("%.4f", timeInSeconds2) + " seconds");
        System.out.println("Speedup with threads: " + String.format("%.2f", timeInSeconds2 / timeInSeconds) + "x");
    }
}
